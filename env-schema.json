{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "description": "",
    "type": "object",
    "properties": {
        "mnemonic": {
            "type": "string"
        },
        "etherscanApiKey": {
            "type": "string"
        },
        "rpcURL": {
            "type": "string"
        },
        "botAddr": {
            "type": "string"
        },
        "numConfirmBlocks": {
            "type": "number"
        },
        "postDeploySetup": {
            "type": "boolean"
        },
        "gnosisSafeAddr": {
            "type": "object",
            "properties": {
                "primary": {
                    "type": "string"
                },
                "secondary": {
                    "type": "string"
                }
            },
            "required": ["primary", "secondary"]
        },
        "addressStore": {
            "type": "object",
            "properties": {
                "address": {
                    "type": "string"
                },
                "deploy": {
                    "type": "boolean"
                }
            },
            "required": ["address", "deploy"]
        },
        "timelockedAdmin": {
            "type": "object",
            "properties": {
                "address": {
                    "type": "string"
                },
                "deploy": {
                    "type": "boolean"
                },
                "init": {
                    "type": "object",
                    "properties": {
                        "minDelay": {
                            "type": "string",
                            "minLength": 1
                        }
                    },
                    "required": ["minDelay"]
                }
            },
            "required": ["address", "deploy", "init"]
        },
        "stkBNB": {
            "type": "object",
            "properties": {
                "address": {
                    "type": "string"
                },
                "deploy": {
                    "type": "boolean"
                }
            },
            "required": ["address", "deploy"]
        },
        "delegationManager": {
            "type": "object",
            "properties": {
                "address": {
                    "type": "string"
                },
                "deploy": {
                    "type": "boolean"
                }
            },
            "required": ["address", "deploy"]
        },
        "feeVault": {
            "type": "object",
            "properties": {
                "address": {
                    "type": "string"
                },
                "deploy": {
                    "type": "boolean"
                },
                "upgrade": {
                    "type": "boolean"
                }
            },
            "required": ["address", "deploy", "upgrade"]
        },
        "stakePool": {
            "type": "object",
            "properties": {
                "address": {
                    "type": "string"
                },
                "deploy": {
                    "type": "boolean"
                },
                "upgrade": {
                    "type": "boolean"
                },
                "init": {
                    "type": "object",
                    "properties": {
                        "config": {
                            "type": "object",
                            "properties": {
                                "bcStakingWallet_deprecated": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "minDelegationAmount": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "transferOutTimeout_deprecated": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "minBNBDeposit": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "minTokenWithdrawal": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "cooldownPeriod": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "fee": {
                                    "type": "object",
                                    "properties": {
                                        "reward": {
                                            "type": "number"
                                        },
                                        "deposit": {
                                            "type": "number"
                                        },
                                        "withdraw": {
                                            "type": "number"
                                        }
                                    },
                                    "required": ["reward", "deposit", "withdraw"]
                                }
                            },
                            "required": [
                                "bcStakingWallet_deprecated",
                                "minDelegationAmount",
                                "transferOutTimeout_deprecated",
                                "minBNBDeposit",
                                "minTokenWithdrawal",
                                "cooldownPeriod",
                                "fee"
                            ]
                        }
                    },
                    "required": ["config"]
                }
            },
            "required": ["address", "deploy", "upgrade", "init"]
        }
    },
    "required": [
        "mnemonic",
        "etherscanApiKey",
        "rpcURL",
        "botAddr",
        "numConfirmBlocks",
        "postDeploySetup",
        "gnosisSafeAddr",
        "addressStore",
        "timelockedAdmin",
        "stkBNB",
        "delegationManager",
        "feeVault",
        "stakePool"
    ]
}
